---
source: crates/core/tests/claude_transcribe.rs
expression: "request_body(&encode_jpeg(&img), Model::Opus, EFFORT)"
---
{
  "fallbacks": "default",
  "max_tokens": 16000,
  "messages": [
    {
      "content": [
        {
          "source": {
            "data": "",
            "media_type": "image/jpeg",
            "type": "base64"
          },
          "transformations": {
            "oversized_image": "error"
          },
          "type": "image"
        },
        {
          "text": "Transcribe this photo of a handwritten notebook page.\n- Write exactly what's on the page: keep the author's spelling, abbreviations and line breaks. Don't correct or complete anything.\n- One `lines` entry per handwritten line, top to bottom, with its markdown and box. Use markdown only for structure the page shows (headings, bullets, numbered lists, checkboxes). An empty `text_md` with a null box marks a paragraph break.\n- Underlined text, even a whole underlined line: <u>text</u>. Superscript: <sup>th</sup>. Crossed-out text: ~~strikethrough~~. Drawings: `[drawing: short description]`.\n- A line holding only a dash or short rule: `---`, with its box.\n- Add an `uncertain` entry for each word or phrase you're unsure of: line index (0-based), the text exactly as it appears in that line, its box, and 1–3 other likely readings.\n- Boxes are [x0, y0, x1, y1] in pixels of this image.",
          "type": "text"
        }
      ],
      "role": "user"
    }
  ],
  "model": "claude-opus-5-5",
  "output_config": {
    "effort": "high",
    "format": {
      "schema": {
        "additionalProperties": false,
        "properties": {
          "lines": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "bbox": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "text_md": {
                  "type": "string"
                }
              },
              "required": [
                "text_md",
                "bbox"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "uncertain": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "alternatives": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "bbox": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "line": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "line",
                "text",
                "bbox",
                "alternatives"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "lines",
          "uncertain"
        ],
        "type": "object"
      },
      "type": "json_schema"
    }
  }
}
